{
  "name": "caso03-upload-typescript",
  "version": "1.0.0",
  "description": "Aplicacao web com upload e download de arquivos usando Express e TypeScript",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.2",
    "mysql2": "^3.15.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.23",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.25",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
