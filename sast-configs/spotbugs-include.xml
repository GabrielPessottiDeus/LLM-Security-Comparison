<?xml version="1.0" encoding="UTF-8"?>
<!--
  Filtro do SpotBugs: incluímos TODAS as categorias relevantes para análise
  de vulnerabilidades, em especial as do plugin find-sec-bugs.
  Documentação: https://spotbugs.readthedocs.io/
-->
<FindBugsFilter>
    <!-- Vulnerabilidades de segurança (find-sec-bugs) -->
    <Match>
        <Bug category="SECURITY"/>
    </Match>
    <!-- Categorias padrão do SpotBugs -->
    <Match>
        <Bug category="MALICIOUS_CODE"/>
    </Match>
    <Match>
        <Bug category="BAD_PRACTICE"/>
    </Match>
    <Match>
        <Bug category="CORRECTNESS"/>
    </Match>
</FindBugsFilter>
